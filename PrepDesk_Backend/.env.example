PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/prepdeck
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# In dev, requests reach the API through the Vite proxy, so use the client origin here
SERVER_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email verification. Leave SMTP_HOST empty in development to print links in the server console.
REQUIRE_VERIFIED_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PrepDeck <no-reply@your-domain.example>"
